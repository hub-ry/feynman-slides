{
  "id": "anki-minimal",
  "name": "Anki Minimal",
  "author": "community",
  "version": "1.0.0",
  "description": "High contrast active-recall study theme with prompt cues and clear answer cards.",
  "palette": {
    "paper": "#101216",
    "ink": "#f8fafc",
    "muted": "#8b949e",
    "accent": "#38bdf8"
  },
  "roles": {
    "title": {
      "family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif",
      "size": 38,
      "weight": 700,
      "line": 1.2,
      "letter": "-0.015em",
      "color": "ink",
      "align": "left"
    },
    "body": {
      "family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif",
      "size": 22,
      "weight": 400,
      "line": 1.5,
      "letter": "0",
      "color": "ink",
      "align": "left"
    },
    "caption": {
      "family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif",
      "size": 14,
      "weight": 500,
      "line": 1.4,
      "letter": "0.03em",
      "color": "muted",
      "align": "left"
    },
    "prompt": {
      "family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif",
      "size": 15,
      "weight": 600,
      "line": 1.4,
      "letter": "0.05em",
      "color": "accent",
      "align": "left"
    }
  },
  "layouts": [
    {
      "id": "title",
      "name": "Title",
      "els": [
        {
          "type": "shape",
          "shape": "line",
          "fill": "accent",
          "x": 96,
          "y": 160,
          "w": 48,
          "h": 4
        },
        {
          "type": "text",
          "role": "title",
          "x": 96,
          "y": 184,
          "w": 768,
          "h": 112,
          "hint": "Deck Title"
        },
        {
          "type": "text",
          "role": "caption",
          "x": 96,
          "y": 312,
          "w": 768,
          "h": 44,
          "hint": "Active recall deck • 40 cards"
        }
      ]
    },
    {
      "id": "title-body",
      "name": "Title and body",
      "els": [
        {
          "type": "text",
          "role": "caption",
          "x": 72,
          "y": 48,
          "w": 816,
          "h": 28,
          "hint": "Deck :: Subdeck"
        },
        {
          "type": "text",
          "role": "title",
          "x": 72,
          "y": 84,
          "w": 816,
          "h": 84,
          "hint": "Question / Recall prompt"
        },
        {
          "type": "shape",
          "shape": "line",
          "fill": "accent",
          "x": 72,
          "y": 182,
          "w": 816,
          "h": 2
        },
        {
          "type": "text",
          "role": "prompt",
          "x": 72,
          "y": 200,
          "w": 200,
          "h": 28,
          "hint": "Answer"
        },
        {
          "type": "text",
          "role": "body",
          "x": 72,
          "y": 236,
          "w": 816,
          "h": 240,
          "hint": "Revealed answer & explanation"
        }
      ]
    },
    {
      "id": "cloze",
      "name": "Cloze deletion",
      "els": [
        {
          "type": "text",
          "role": "caption",
          "x": 72,
          "y": 56,
          "w": 816,
          "h": 28,
          "hint": "[...]"
        },
        {
          "type": "text",
          "role": "title",
          "x": 72,
          "y": 104,
          "w": 816,
          "h": 140,
          "hint": "The powerhouse of the cell is the [==mitochondria==]."
        },
        {
          "type": "shape",
          "shape": "line",
          "fill": "muted",
          "x": 72,
          "y": 264,
          "w": 120,
          "h": 2
        },
        {
          "type": "text",
          "role": "body",
          "x": 72,
          "y": 288,
          "w": 816,
          "h": 180,
          "hint": "Explanation / Extra context"
        }
      ]
    },
    {
      "id": "split-recall",
      "name": "Front and back",
      "els": [
        {
          "type": "text",
          "role": "title",
          "x": 72,
          "y": 48,
          "w": 816,
          "h": 64,
          "hint": "Concept"
        },
        {
          "type": "text",
          "role": "prompt",
          "x": 72,
          "y": 130,
          "w": 384,
          "h": 32,
          "hint": "FRONT (PROMPT)"
        },
        {
          "type": "text",
          "role": "body",
          "x": 72,
          "y": 172,
          "w": 384,
          "h": 300,
          "hint": "Recall stimulus"
        },
        {
          "type": "text",
          "role": "prompt",
          "x": 504,
          "y": 130,
          "w": 384,
          "h": 32,
          "hint": "BACK (ANSWER)"
        },
        {
          "type": "text",
          "role": "body",
          "x": 504,
          "y": 172,
          "w": 384,
          "h": 300,
          "hint": "Detailed solution"
        }
      ]
    },
    {
      "id": "section",
      "name": "Section",
      "els": [
        {
          "type": "shape",
          "shape": "line",
          "fill": "accent",
          "x": 72,
          "y": 230,
          "w": 64,
          "h": 4
        },
        {
          "type": "text",
          "role": "title",
          "x": 72,
          "y": 254,
          "w": 816,
          "h": 90,
          "hint": "Chapter / Module"
        }
      ]
    },
    {
      "id": "blank",
      "name": "Blank",
      "els": []
    }
  ]
}
